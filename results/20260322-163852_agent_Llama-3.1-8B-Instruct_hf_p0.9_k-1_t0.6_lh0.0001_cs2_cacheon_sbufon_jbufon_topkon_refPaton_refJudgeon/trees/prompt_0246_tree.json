g.\"\n                },\n                \"reason\": {\n                    \"type\": \"string\",\n                    \"description\": \"The reason for flagging the post.\"\n                }\n            },\n            \"required\": [\n                \"url\",\n                \"post_id\",\n                \"reason\"\n            ]\n        },\n        \"type\": \"object\"\n    }\n}\n\nPlease check the latest posts on `www.globalupdates.com` for any content that requires moderation.<|eot_id|><|start_header_id|>assistant<|end_header_id|>\n\n",
